<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CopilotCredits.MainWindow"
        Title="Copilot Credits"
        Icon="/Assets/icon.png"
        Width="250"
        Height="150"
        Background="#F4F7F7"
        Topmost="True">
        
    <Grid Margin="14">
        <Border Padding="22" Background="#FFFFFF" BorderBrush="#D6E1E2" BorderThickness="1" CornerRadius="8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="UsedCreditsText" FontSize="16" FontWeight="SemiBold" Foreground="#D4563D" Text="--" HorizontalAlignment="Center" />
                
                <TextBlock Margin="2,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#557178" Text="AI CREDITS USED" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
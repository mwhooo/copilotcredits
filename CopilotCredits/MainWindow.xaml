<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CopilotCredits.MainWindow"
        Title="Copilot Credits"
        Icon="/Assets/icon.png"
        Width="250"
        Height="150"
        Background="#F4F7F7"
        Topmost="True">
        
    <Grid Margin="14">
        <Border Padding="22" Background="#FFFFFF" BorderBrush="#D6E1E2" BorderThickness="1" CornerRadius="8">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="UsedCreditsText" FontSize="16" FontWeight="SemiBold" Foreground="#D4563D" Text="--" />
                    <TextBlock Margin="4,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#557178" Text="/" />
                    <TextBlock x:Name="TotalCreditsText" Margin="4,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#557178" Text="--" />
                </StackPanel>
                
                <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#557178" Text="AI CREDITS" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>